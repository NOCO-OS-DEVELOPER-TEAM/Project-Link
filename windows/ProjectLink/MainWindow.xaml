<Window x:Class="ProjectLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Link"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#07070F"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <Window.Resources>
    <Storyboard x:Key="RainbowSpin" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="RainbowRotate" Storyboard.TargetProperty="Angle"
                       From="0" To="360" Duration="0:0:14"/>
    </Storyboard>
  </Window.Resources>

  <Grid>
    <!-- Animated aurora background -->
    <Rectangle>
      <Rectangle.Fill>
        <RadialGradientBrush GradientOrigin="0.2,0.1" Center="0.3,0.2" RadiusX="0.9" RadiusY="0.7">
          <GradientStop Color="#2A0A4A" Offset="0"/>
          <GradientStop Color="#07070F" Offset="1"/>
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle Opacity="0.55">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <LinearGradientBrush.RelativeTransform>
            <RotateTransform x:Name="RainbowRotate" CenterX="0.5" CenterY="0.5"/>
          </LinearGradientBrush.RelativeTransform>
          <GradientStop Color="#AAFF2BD6" Offset="0"/>
          <GradientStop Color="#6600E5FF" Offset="0.33"/>
          <GradientStop Color="#66FFD166" Offset="0.66"/>
          <GradientStop Color="#AA7C4DFF" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle Opacity="0.25">
      <Rectangle.Fill>
        <RadialGradientBrush Center="0.85,0.8" RadiusX="0.55" RadiusY="0.45">
          <GradientStop Color="#FF00C2FF" Offset="0"/>
          <GradientStop Color="#00000000" Offset="1"/>
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <Grid Margin="28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <DockPanel Grid.Row="0" Margin="0,0,0,18">
        <StackPanel Orientation="Horizontal">
          <Border Width="46" Height="46" CornerRadius="14" Margin="0,0,14,0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF5AF5" Offset="0"/>
                <GradientStop Color="#00E8FF" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="⟷" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="PROJECT LINK" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="SubtitleText" Text="Native iPhone ↔ Windows · LAN only" Foreground="#B8B8D8" FontSize="13"/>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border x:Name="StatusPill" CornerRadius="16" Padding="14,8" Background="#22FFFFFF" Margin="0,0,10,0">
            <TextBlock x:Name="StatusText" Text="Starting…" Foreground="White" FontWeight="SemiBold"/>
          </Border>
          <TextBlock x:Name="LatencyText" Text="RTT —" Foreground="#A0FFE8" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </StackPanel>
      </DockPanel>

      <!-- Body -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="380"/>
          <ColumnDefinition Width="18"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: QR + pairing -->
        <Border Grid.Column="0" CornerRadius="22" Padding="22" Background="#CC10101C" BorderThickness="1">
          <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#80FF5AF5" Offset="0"/>
              <GradientStop Color="#4000E8FF" Offset="1"/>
            </LinearGradientBrush>
          </Border.BorderBrush>
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Scan to pair" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="Same Wi‑Fi. QR holds IP + one-time token." Foreground="#9A9AB8" Margin="0,4,0,14" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
              <TextBlock x:Name="LanText" Foreground="#C8C8E8" Margin="0,0,0,8" TextWrapping="Wrap"/>
              <UniformGrid Columns="2" Margin="0,0,0,8">
                <Button Content="New QR" Style="{StaticResource GlowButton}" Margin="0,0,6,0"
                        Background="#33181828" Click="RotateToken_Click"/>
                <Button Content="Copy payload" Style="{StaticResource GlowButton}" Margin="6,0,0,0"
                        Background="#33181828" Click="CopyQr_Click"/>
              </UniformGrid>
              <Slider x:Name="SensSlider" Minimum="0.4" Maximum="3.0" Value="1.35" TickFrequency="0.05"
                      IsSnapToTickEnabled="True" ValueChanged="SensSlider_ValueChanged"/>
              <TextBlock x:Name="SensLabel" Text="Sensitivity 1.35×" Foreground="#9A9AB8" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Background="#0A0A12" CornerRadius="16" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Image x:Name="QrImage" Width="260" Height="260" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
          </DockPanel>
        </Border>

        <!-- Right: tabs -->
        <Border Grid.Column="2" CornerRadius="22" Background="#CC10101C" BorderThickness="1" Padding="8">
          <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
              <GradientStop Color="#4000E8FF" Offset="0"/>
              <GradientStop Color="#80FFE566" Offset="1"/>
            </LinearGradientBrush>
          </Border.BorderBrush>
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,12">
              <ToggleButton x:Name="TabDashboard" Content="Dashboard" Style="{StaticResource NeonToggle}" IsChecked="True" Checked="Tab_Checked" Margin="0,0,8,0"/>
              <ToggleButton x:Name="TabPhoneScreen" Content="iPhone Screen" Style="{StaticResource NeonToggle}" Checked="Tab_Checked" Margin="0,0,8,0"/>
              <ToggleButton x:Name="TabFiles" Content="Files" Style="{StaticResource NeonToggle}" Checked="Tab_Checked" Margin="0,0,8,0"/>
              <ToggleButton x:Name="TabLogs" Content="Logs" Style="{StaticResource NeonToggle}" Checked="Tab_Checked"/>
            </StackPanel>

            <Grid Margin="12,0,12,12">
              <!-- Dashboard -->
              <ScrollViewer x:Name="PanelDashboard" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <UniformGrid Columns="2" Margin="0,0,0,12">
                    <Border Background="#1A1528" CornerRadius="16" Padding="16" Margin="0,0,8,8">
                      <StackPanel>
                        <TextBlock Text="CONNECTION" Foreground="#8A8AB0" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="ConnDetail" Text="Waiting for iPhone…" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                    <Border Background="#1A1528" CornerRadius="16" Padding="16" Margin="8,0,0,8">
                      <StackPanel>
                        <TextBlock Text="INPUT" Foreground="#8A8AB0" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="InputStats" Text="0 pkt/s" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border Background="#1A1528" CornerRadius="16" Padding="16" Margin="0,0,8,0">
                      <StackPanel>
                        <TextBlock Text="PC → IPHONE" Foreground="#8A8AB0" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="StreamOutStats" Text="idle" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                          <Button Content="Start stream" Style="{StaticResource GlowButton}" Background="#33201840" Click="StartPcStream_Click" Margin="0,0,8,0"/>
                          <Button Content="Test capture" Style="{StaticResource GlowButton}" Background="#33201840" Click="TestCapture_Click"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border Background="#1A1528" CornerRadius="16" Padding="16" Margin="8,0,0,0">
                      <StackPanel>
                        <TextBlock Text="CLIPBOARD" Foreground="#8A8AB0" FontSize="11" FontWeight="Bold"/>
                        <CheckBox x:Name="ClipToggle" Content="Sync text with phone" Foreground="White" Margin="0,10,0,0" Checked="ClipToggle_Changed" Unchecked="ClipToggle_Changed"/>
                        <TextBlock Text="iOS: sync on app open / Share — no silent background clipboard." Foreground="#7A7A98" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                      </StackPanel>
                    </Border>
                  </UniformGrid>

                  <Border Background="#1A1528" CornerRadius="16" Padding="16">
                    <StackPanel>
                      <TextBlock Text="QUICK ACTIONS" Foreground="#8A8AB0" FontSize="11" FontWeight="Bold"/>
                      <WrapPanel Margin="0,10,0,0">
                        <Button Content="⏯ Play/Pause" Style="{StaticResource GlowButton}" Background="#281828" Margin="0,0,8,8" Click="Media_Click" Tag="play_pause"/>
                        <Button Content="🔊 Vol+" Style="{StaticResource GlowButton}" Background="#281828" Margin="0,0,8,8" Click="Media_Click" Tag="vol_up"/>
                        <Button Content="🔉 Vol−" Style="{StaticResource GlowButton}" Background="#281828" Margin="0,0,8,8" Click="Media_Click" Tag="vol_down"/>
                        <Button Content="🔇 Mute" Style="{StaticResource GlowButton}" Background="#281828" Margin="0,0,8,8" Click="Media_Click" Tag="mute"/>
                      </WrapPanel>
                      <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="Launch" Style="{StaticResource GlowButton}" Background="#281828" Click="Launch_Click" Margin="8,0,0,0"/>
                        <TextBox x:Name="LaunchBox" Background="#0E0E18" Foreground="White" BorderBrush="#33334A" Padding="10,8"
                                 Text="notepad" CaretBrush="White"/>
                      </DockPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>

              <!-- iPhone screen mirror -->
              <Grid x:Name="PanelPhoneScreen" Visibility="Collapsed">
                <Border Background="#0A0A12" CornerRadius="16">
                  <Grid>
                    <TextBlock x:Name="PhoneScreenHint" Text="Waiting for iPhone screen stream on :47803…"
                               Foreground="#8A8AB0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="PhoneScreenImage" Stretch="Uniform" Margin="8"/>
                  </Grid>
                </Border>
                <TextBlock x:Name="PhoneFpsText" Text="" Foreground="#A0FFE8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"/>
              </Grid>

              <!-- Files -->
              <StackPanel x:Name="PanelFiles" Visibility="Collapsed">
                <TextBlock Text="Transfer files over LAN to the paired iPhone." Foreground="#B8B8D8" Margin="0,0,0,12"/>
                <Button Content="Send file to iPhone…" Style="{StaticResource GlowButton}" Background="#281828" HorizontalAlignment="Left" Click="SendFile_Click"/>
                <TextBlock x:Name="FileProgress" Foreground="#A0FFE8" Margin="0,12,0,0"/>
                <TextBlock x:Name="InboxPath" Foreground="#8A8AB0" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <Button Content="Open inbox" Style="{StaticResource GlowButton}" Background="#281828" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenInbox_Click"/>
              </StackPanel>

              <!-- Logs -->
              <DockPanel x:Name="PanelLogs" Visibility="Collapsed">
                <Button DockPanel.Dock="Top" Content="Clear" Style="{StaticResource GlowButton}" Background="#281828" HorizontalAlignment="Left" Margin="0,0,0,8" Click="ClearLogs_Click"/>
                <ListBox x:Name="LogList" Background="#0A0A12" Foreground="#C8C8E0" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12"/>
              </DockPanel>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Footer -->
      <DockPanel Grid.Row="2" Margin="0,14,0,0">
        <TextBlock DockPanel.Dock="Left" Text="No cloud · AES-GCM pairing · UDP input · JPEG screen" Foreground="#6A6A88" FontSize="11"/>
        <CheckBox x:Name="AutostartCheck" DockPanel.Dock="Right" Content="Start with Windows" Foreground="#9A9AB8"
                  HorizontalAlignment="Right" Checked="Autostart_Changed" Unchecked="Autostart_Changed"/>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
